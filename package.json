{
  "name": "esp32-radio-control",
  "version": "1.0.0",
  "private": true,
  "description": "ESP32 drive/display and independent camera fleet controller",
  "scripts": {
    "dev": "npm --prefix web-controller run dev",
    "build": "npm --prefix web-controller run build",
    "start": "npm --prefix web-controller run start",
    "test": "npm --prefix web-controller run test:fleet",
